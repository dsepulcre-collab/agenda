<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modo Conducción ✨ Agenda RV</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .pulse-animation {
            animation: pulse 1.5s infinite;
        }
        @keyframes pulse {
            0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
            70% { transform: scale(1.05); box-shadow: 0 0 0 20px rgba(239, 68, 68, 0); }
            100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
        }
        .driving-btn {
            touch-action: manipulation;
        }
        .ai-glow {
            box-shadow: 0 0 20px rgba(99, 102, 241, 0.4);
        }
    </style>
    <script>
        let gisReady = false;
        let gapiReady = false;

        function libLoaded(lib) {
            if (lib === 'gis') gisReady = true;
            if (lib === 'gapi') gapiReady = true;
            if (gisReady && gapiReady) {
                setTimeout(() => {
                    if (typeof initServices === 'function') initServices();
                }, 200);
            }
        }
    </script>
</head>
<body class="bg-slate-900 min-h-screen flex flex-col items-center p-4 font-sans text-slate-100 text-center">

    <div class="max-w-md w-full bg-slate-800 rounded-[3rem] shadow-2xl overflow-hidden mt-4 border border-slate-700 relative">
        
        <!-- Botón de Ajustes -->
        <button id="settings-btn" class="absolute top-8 right-8 text-slate-400 hover:text-white z-20 p-2">
            <i class="fa-solid fa-gear text-xl"></i>
        </button>

        <!-- Cabecera -->
        <div class="bg-gradient-to-br from-indigo-600 to-blue-700 p-8 text-white text-center">
            <h1 class="text-2xl font-black tracking-tight">AGENDA RV ✨</h1>
            <p class="text-indigo-100 text-xs font-medium uppercase tracking-widest mt-1 italic text-center">IA Security Enhanced</p>
        </div>

        <!-- Pantalla de Autenticación / Ayuda OAuth -->
        <div id="auth-section" class="p-8 text-center">
            <i class="fa-solid fa-shield-check text-6xl text-indigo-500 mb-6 opacity-80"></i>
            
            <div id="setup-warning" class="hidden mb-6 p-4 bg-red-500/20 border-2 border-red-500/50 rounded-2xl text-red-100 text-sm text-left">
                <b class="uppercase block mb-1">Faltan Credenciales</b>
                Pulsa el icono ⚙️ arriba a la derecha para introducir tu <b>Google API Key</b> y <b>Client ID</b>.
            </div>

            <div id="oauth-helper" class="mb-6 p-5 bg-indigo-500/10 border-2 border-indigo-500/30 rounded-2xl text-slate-100 text-sm text-left">
                <div class="flex items-center mb-2 text-indigo-400">
                    <i class="fa-solid fa-link text-lg mr-2"></i>
                    <b class="text-xs uppercase">Origen para Google Cloud:</b>
                </div>
                
                <div class="bg-black/60 p-3 rounded-xl mb-4 flex items-center justify-between border border-slate-600">
                    <code id="current-url" class="text-indigo-300 break-all text-[11px] font-mono">Obteniendo...</code>
                    <button onclick="copyURL()" class="ml-2 p-2 bg-slate-700 hover:bg-slate-600 rounded-lg transition-colors">
                        <i class="fa-solid fa-copy"></i>
                    </button>
                </div>
                <p class="text-[10px] opacity-70 italic">Copia esto y ponlo en "Orígenes de JavaScript autorizados".</p>
            </div>

            <button id="auth-button" class="w-full bg-white text-slate-900 font-bold py-5 px-6 rounded-2xl flex items-center justify-center shadow-lg active:scale-95 transition-all disabled:opacity-50">
                <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" class="w-6 h-6 mr-3" alt="Google logo">
                CONECTAR GOOGLE
            </button>
        </div>

        <!-- Panel de Ajustes (Aquí se meten las llaves ahora) -->
        <div id="settings-panel" class="hidden p-8 space-y-4 bg-slate-900 absolute inset-0 z-30 flex flex-col pt-20 overflow-y-auto">
            <h2 class="text-xl font-bold border-b border-slate-700 pb-2 flex items-center text-white">
                <i class="fa-solid fa-key mr-2 text-indigo-400"></i> Configuración Segura
            </h2>
            
            <div class="space-y-4 text-left">
                <div>
                    <label class="text-[10px] font-bold text-slate-500 uppercase">Google API Key (AIza...)</label>
                    <input type="password" id="config-api-key" placeholder="Pega tu API Key aquí" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3 text-sm mt-1 text-white focus:border-indigo-500 outline-none">
                </div>
                <div>
                    <label class="text-[10px] font-bold text-slate-500 uppercase">Google Client ID</label>
                    <input type="text" id="config-client-id" placeholder="...apps.googleusercontent.com" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3 text-sm mt-1 text-white focus:border-indigo-500 outline-none">
                </div>
                <div class="border-t border-slate-700 pt-4">
                    <label class="text-[10px] font-bold text-slate-500 uppercase">Nombre del Doc en Drive</label>
                    <input type="text" id="config-doc-name" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3 text-sm mt-1 text-white focus:border-indigo-500 outline-none">
                </div>
                <div>
                    <label class="text-[10px] font-bold text-slate-500 uppercase">ID Directo del Doc (Opcional)</label>
                    <input type="text" id="config-doc-id" placeholder="ID de la URL de Docs" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3 text-sm mt-1 text-white font-mono focus:border-indigo-500 outline-none">
                </div>
            </div>

            <div class="pt-4 space-y-3">
                <button id="save-settings" class="w-full py-4 bg-indigo-600 rounded-2xl font-bold shadow-lg text-white uppercase text-xs tracking-widest">Guardar y Aplicar</button>
                <button id="close-settings" class="w-full py-4 bg-slate-800 rounded-2xl font-bold text-slate-400 uppercase text-xs tracking-widest">Cerrar</button>
            </div>
        </div>

        <!-- App Principal -->
        <div id="app-section" class="hidden p-8 space-y-6">
            <div class="bg-slate-900/50 p-4 rounded-2xl border border-slate-700 text-center">
                <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest block mb-1">Agenda Conectada</span>
                <div id="doc-name" class="text-indigo-400 font-bold truncate text-sm italic">...</div>
            </div>

            <div class="text-center space-y-4 py-4">
                <div id="status-indicator" class="text-sm font-black text-slate-500 uppercase tracking-widest">SISTEMA LISTO</div>
                <div id="transcription-preview" class="min-h-[160px] p-6 bg-slate-900/80 border-2 border-slate-700 rounded-[2.5rem] text-slate-300 italic text-lg flex flex-col items-center justify-center text-center leading-relaxed">
                    <span id="preview-text">"Pulsa el micro y habla"</span>
                    <div id="ai-loading" class="hidden mt-4 items-center text-indigo-400 font-bold text-xs uppercase tracking-widest">
                        <i class="fa-solid fa-wand-magic-sparkles animate-pulse mr-2"></i> Procesando con Gemini...
                    </div>
                </div>
            </div>

            <div class="flex flex-col items-center space-y-6">
                <button id="record-btn" class="driving-btn w-32 h-32 bg-indigo-600 text-white rounded-full flex items-center justify-center shadow-[0_0_40px_rgba(79,70,229,0.3)] hover:bg-indigo-500 transition-all active:scale-90 border-[10px] border-slate-800 outline outline-4 outline-indigo-500/20">
                    <i id="mic-icon" class="fa-solid fa-microphone text-5xl text-white"></i>
                </button>
                
                <button id="ai-refine-btn" class="hidden w-full py-5 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-black rounded-2xl shadow-xl transition-all active:scale-95 flex items-center justify-center ai-glow uppercase text-xs tracking-widest">
                    <i class="fa-solid fa-sparkles mr-3"></i> OPTIMIZAR CON IA
                </button>
            </div>
        </div>
    </div>

    <div id="msg-box" class="fixed top-10 left-1/2 -translate-x-1/2 w-11/12 max-w-xs px-6 py-4 rounded-2xl bg-white text-slate-900 font-bold text-center shadow-2xl opacity-0 transition-opacity pointer-events-none z-50 border-b-4 border-indigo-600 uppercase text-xs">
        MENSAJE
    </div>

    <!-- Librerías Google -->
    <script src="https://accounts.google.com/gsi/client" async defer onload="libLoaded('gis')"></script>
    <script src="https://apis.google.com/js/api.js" async defer onload="libLoaded('gapi')"></script>

    <script>
        // CONFIGURACIÓN: Ahora el código está limpio de claves
        const SCOPES = 'https://www.googleapis.com/auth/documents https://www.googleapis.com/auth/drive.file';
        const geminiApiKey = ""; // Inyectada por el entorno

        // Estado persistente (localStorage)
        let savedApiKey = localStorage.getItem('cfg_api_key') || '';
        let savedClientId = localStorage.getItem('cfg_client_id') || '';
        let configDocName = localStorage.getItem('cfg_doc_name') || 'Agenda de Interacciones Clientes';
        let configDocId = localStorage.getItem('cfg_doc_id') || '';
        let documentId = configDocId || localStorage.getItem('google_doc_id') || null;

        let tokenClient;
        let accessToken = null;
        let lastTranscript = "";

        // UI Selectors
        const authSection = document.getElementById('auth-section');
        const appSection = document.getElementById('app-section');
        const settingsPanel = document.getElementById('settings-panel');
        const recordBtn = document.getElementById('record-btn');
        const aiBtn = document.getElementById('ai-refine-btn');
        const statusInd = document.getElementById('status-indicator');
        const previewText = document.getElementById('preview-text');
        const aiLoading = document.getElementById('ai-loading');

        window.addEventListener('DOMContentLoaded', () => {
            document.getElementById('current-url').textContent = window.location.origin;
            document.getElementById('config-api-key').value = savedApiKey;
            document.getElementById('config-client-id').value = savedClientId;
            document.getElementById('config-doc-name').value = configDocName;
            document.getElementById('config-doc-id').value = configDocId;

            if (!savedApiKey || !savedClientId) {
                document.getElementById('setup-warning').classList.remove('hidden');
            }
        });

        function copyURL() {
            const text = document.getElementById('current-url').textContent;
            const temp = document.createElement("input");
            document.body.appendChild(temp);
            temp.value = text;
            temp.select();
            document.execCommand("copy");
            document.body.removeChild(temp);
            showMsg("ORIGEN COPIADO");
        }

        // --- MANEJO DE AJUSTES ---
        document.getElementById('settings-btn').onclick = () => settingsPanel.classList.remove('hidden');
        document.getElementById('close-settings').onclick = () => settingsPanel.classList.add('hidden');
        document.getElementById('save-settings').onclick = () => {
            localStorage.setItem('cfg_api_key', document.getElementById('config-api-key').value);
            localStorage.setItem('cfg_client_id', document.getElementById('config-client-id').value);
            localStorage.setItem('cfg_doc_name', document.getElementById('config-doc-name').value);
            localStorage.setItem('cfg_doc_id', document.getElementById('config-doc-id').value);
            showMsg("AJUSTES GUARDADOS");
            setTimeout(() => location.reload(), 800);
        };

        // --- INICIALIZACIÓN ---
        async function initServices() {
            if (!savedApiKey || !savedClientId) {
                console.warn("Faltan credenciales en ajustes.");
                return;
            }
            try {
                await new Promise((resolve, reject) => gapi.load('client', { callback: resolve, onerror: reject }));
                await gapi.client.init({
                    apiKey: savedApiKey,
                    discoveryDocs: ["https://docs.googleapis.com/$discovery/rest?version=v1", "https://www.googleapis.com/discovery/v1/apis/drive/v3/rest"],
                });
                tokenClient = google.accounts.oauth2.initTokenClient({
                    client_id: savedClientId,
                    scope: SCOPES,
                    callback: (resp) => {
                        if (resp.error) return showMsg("ERROR AUTH");
                        accessToken = resp.access_token;
                        startApp();
                    },
                });
                initSpeech();
            } catch (err) { console.error("Fallo Init:", err); }
        }

        // --- IA GEMINI ---
        async function callGemini(prompt) {
            const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${geminiApiKey}`;
            const payload = {
                contents: [{ parts: [{ text: prompt }] }],
                systemInstruction: { parts: [{ text: "Asistente experto para RV Neoresins. Convierte notas de voz en informes profesionales estructurados." }] }
            };
            const response = await fetch(url, { method: 'POST', body: JSON.stringify(payload) });
            const data = await response.json();
            return data.candidates?.[0]?.content?.parts?.[0]?.text;
        }

        async function processWithAI() {
            if (!lastTranscript) return;
            aiLoading.classList.remove('hidden');
            aiBtn.disabled = true;
            speak("Analizando");
            try {
                const aiResult = await callGemini(`Estructura nota: "${lastTranscript}"`);
                lastTranscript = aiResult;
                previewText.textContent = aiResult;
                await saveNote(aiResult, true);
                aiBtn.classList.add('hidden');
            } catch (err) { showMsg("ERROR IA"); } finally {
                aiLoading.classList.add('hidden');
                aiBtn.disabled = false;
            }
        }

        // --- VOZ ---
        function speak(text) {
            if ('speechSynthesis' in window) {
                const u = new SpeechSynthesisUtterance(text);
                u.lang = 'es-ES';
                window.speechSynthesis.speak(u);
            }
        }

        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        let recognition = null;
        let isRecording = false;

        function initSpeech() {
            if (SpeechRecognition) {
                recognition = new SpeechRecognition();
                recognition.lang = 'es-ES';
                recognition.interimResults = true;
                recognition.onstart = () => {
                    isRecording = true;
                    recordBtn.classList.add('pulse-animation', 'bg-red-500');
                    statusInd.textContent = "ESCUCHANDO...";
                    previewText.textContent = "...";
                    aiBtn.classList.add('hidden');
                    speak("Escuchando");
                };
                recognition.onresult = (e) => {
                    previewText.textContent = Array.from(e.results).map(r => r[0].transcript).join('');
                };
                recognition.onend = () => {
                    isRecording = false;
                    recordBtn.classList.remove('pulse-animation', 'bg-red-500');
                    statusInd.textContent = "SISTEMA LISTO";
                    const text = previewText.textContent.trim();
                    if (text && text.length > 3 && text !== "...") {
                        lastTranscript = text;
                        aiBtn.classList.remove('hidden');
                        saveNote(text, false);
                    }
                };
            }
        }

        async function saveNote(text, isAI = false) {
            try {
                const doc = await gapi.client.docs.documents.get({ documentId: documentId });
                const endIdx = doc.result.body.content[doc.result.body.content.length - 1].endIndex - 1;
                const now = new Date();
                let timestamp = `\n\n--------------------------------------------\n`;
                timestamp += isAI ? `✨ NOTA IA RV (${now.toLocaleString()})\n` : `📅 ORIGINAL (${now.toLocaleString()})\n`;
                timestamp += `${text}\n`;
                await gapi.client.docs.documents.batchUpdate({ documentId: documentId, resource: { requests: [{ insertText: { location: { index: endIdx }, text: timestamp } }] } });
                showMsg(isAI ? "IA GUARDADA" : "GUARDADO");
            } catch (err) { showMsg("ERROR DRIVE"); }
        }

        async function startApp() {
            authSection.classList.add('hidden');
            appSection.classList.remove('hidden');
            if (!documentId) await findOrCreateDoc();
            else fetchDocInfo();
        }

        async function findOrCreateDoc() {
            try {
                const query = `name = '${configDocName}' and trashed = false`;
                const resp = await gapi.client.drive.files.list({ q: query });
                const files = resp.result.files;
                if (files && files.length > 0) documentId = files[0].id;
                else {
                    const newDoc = await gapi.client.docs.documents.create({title: configDocName});
                    documentId = newDoc.result.documentId;
                }
                localStorage.setItem('google_doc_id', documentId);
                fetchDocInfo();
            } catch (err) { console.error(err); }
        }

        async function fetchDocInfo() {
            try {
                const doc = await gapi.client.docs.documents.get({ documentId: documentId });
                document.getElementById('doc-name').textContent = doc.result.title;
            } catch (e) { showMsg("ID DOC INVÁLIDO"); }
        }

        document.getElementById('auth-button').onclick = () => {
            if (tokenClient) tokenClient.requestAccessToken();
            else showMsg("CONFIGURA LAS LLAVES EN ⚙️");
        };
        recordBtn.onclick = () => isRecording ? recognition.stop() : recognition.start();
        aiBtn.onclick = () => processWithAI();

        function showMsg(text) {
            const box = document.getElementById('msg-box');
            box.textContent = text;
            box.classList.remove('opacity-0');
            setTimeout(() => box.classList.add('opacity-0'), 4000);
        }
    </script>
</body>
</html>
